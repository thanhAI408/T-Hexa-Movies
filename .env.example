# Leave DATABASE_URL empty to use the PostgreSQL-compatible PGlite fallback.
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite
DATABASE_POOL_SIZE=5

VSMOV_BASE_URL=https://vsmov.com/api
OPHIM_BASE_URL=https://ophim1.com
NGUONC_BASE_URL=https://phim.nguonc.com
KKPHIM_BASE_URL=https://phimapi.com

PROVIDER_TIMEOUT_MS=12000
PROVIDER_CONCURRENCY=4
SYNC_MAX_PAGES=
SYNC_DETAIL_LIMIT=48

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only YouTube Data API v3 key (never NEXT_PUBLIC_)
YOUTUBE_API_KEY=

# Movie chat: all values below are server-only. Provision Redis through Vercel.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
CHAT_SESSION_SECRET=
CHAT_DAILY_TURN_LIMIT=200
KV_REST_API_URL=
KV_REST_API_TOKEN=
